@model List<PortalAcademico.Models.Curso>

<h2>Mis Cursos</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning">
        No estás matriculado en ningún curso.
    </div>
}
else
{
    <table class="table table-striped">

        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Créditos</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var curso in Model)
            {
                <tr>
                    <td>@curso.Codigo</td>
                    <td>@curso.Nombre</td>
                    <td>@curso.Creditos</td>
                </tr>
            }
        </tbody>

    </table>
}