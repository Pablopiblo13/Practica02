@model List<PortalAcademico.Models.Curso>

<h2>Catálogo de Cursos</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-info">
        @TempData["Mensaje"]
    </div>
}

<form method="get" class="mb-3">
    <input type="text" name="nombre" placeholder="Nombre" class="form-control mb-2" />

    <input type="number" name="minCreditos" placeholder="Min Créditos" class="form-control mb-2" />

    <input type="number" name="maxCreditos" placeholder="Max Créditos" class="form-control mb-2" />

    <button type="submit" class="btn btn-primary">Filtrar</button>
    <a href="/Cursos/Index" class="btn btn-secondary">Limpiar</a>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Créditos</th>
            <th>Horario</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var curso in Model)
        {
            <tr>
                <td>@curso.Codigo</td>
                <td>@curso.Nombre</td>
                <td>@curso.Creditos</td>
                <td>@curso.HorarioInicio.ToString("HH:mm") - @curso.HorarioFin.ToString("HH:mm")</td>

                <td>
                    <a class="btn btn-info btn-sm" href="/Cursos/Detalle/@curso.Id">Detalle</a>
                    <a class="btn btn-success btn-sm" href="/Cursos/Inscribirse/@curso.Id">Inscribirse</a>
                    <a class="btn btn-secondary btn-sm" href="/Cursos/MisCursos">Mis Cursos</a>
                </td>
            </tr>
        }
    </tbody>
</table>