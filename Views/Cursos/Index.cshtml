@model List<PortalAcademico.Models.Curso>

<h2>Catálogo de Cursos</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-info">
        @TempData["Mensaje"]
    </div>
}

<form method="get" class="mb-3">

    <input type="text"
           name="nombre"
           value="@Context.Request.Query["nombre"]"
           placeholder="Nombre"
           class="form-control mb-2" />

    <input type="number"
           name="minCreditos"
           value="@Context.Request.Query["minCreditos"]"
           placeholder="Min Créditos"
           class="form-control mb-2" />

    <input type="number"
           name="maxCreditos"
           value="@Context.Request.Query["maxCreditos"]"
           placeholder="Max Créditos"
           class="form-control mb-2" />

    <button type="submit" class="btn btn-primary">Filtrar</button>
    <a href="/Cursos/Index" class="btn btn-secondary">Limpiar</a>

</form>

<table class="table table-striped table-hover">

    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Créditos</th>
            <th>Horario</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @if (Model != null && Model.Any())
        {
            foreach (var curso in Model)
            {
                <tr>
                    <td>@curso.Codigo</td>
                    <td>@curso.Nombre</td>
                    <td>@curso.Creditos</td>

                    <td>
                        @curso.HorarioInicio.ToString("HH:mm")
                        -
                        @curso.HorarioFin.ToString("HH:mm")
                    </td>

                    <td>
                        <a class="btn btn-info btn-sm"
                           href="/Cursos/Detalle/@curso.Id">
                            Detalle
                        </a>

                        <a class="btn btn-success btn-sm"
                           href="/Cursos/Inscribirse/@curso.Id">
                            Inscribirse
                        </a>

                        <a class="btn btn-secondary btn-sm"
                           href="/Cursos/MisCursos">
                            Mis Cursos
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">
                    No hay cursos disponibles
                </td>
            </tr>
        }

    </tbody>

</table>